{
  "name": "@flux/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "backup": "tsx src/ops/cli.ts backup",
    "backup:verify": "tsx src/ops/cli.ts verify",
    "restore": "tsx src/ops/cli.ts restore"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1166.0",
    "@flux/shared": "*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "10.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15"
  }
}
