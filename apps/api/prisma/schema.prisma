// FLUX database schema.
// Domain models are added milestone by milestone (M2 users, M3 roles/permissions/audit, ...).
// Conventions:
//   - UUID primary keys; human-readable business codes as separate @unique columns.
//   - Workflow states are Prisma enums, never free-text strings.
//   - snake_case table/column names via @@map / @map; camelCase in TypeScript.
//   - Multi-tenancy: every tenant-owned table has tenant_id, a row-level security policy using
//     app_current_tenant(), and explicit grants to the flux_app role (see README, "Tenancy").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy (M3a) ──────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// A company subscribed to FLUX. All tenant-owned data is isolated by tenant_id + RLS.
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  /// URL-safe identifier, unique across the platform.
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  modules                                  TenantModule[]
  users                                    User[]
  roles                                    Role[]
  rolePortals                              RolePortal[]
  roleModules                              RoleModule[]
  rolePermissions                          RolePermission[]
  userRoles                                UserRole[]
  auditLogs                                AuditLog[]
  referenceItems                           ReferenceItem[]
  hiddenReference                          ReferenceItemHidden[]
  sequences                                TenantSequence[]
  clients                                  Client[]
  clientAddresses                          ClientAddress[]
  clientContacts                           ClientContact[]
  billingParties                           BillingParty[]
  customFields                             CustomFieldDefinition[]
  vessels                                  Vessel[]
  relationships                            VesselClientRelationship[]
  fleets                                   Fleet[]
  fleetVessels                             FleetVessel[]
  clientNotificationRules                  ClientNotificationRule[]
  clientNotificationRuleContacts           ClientNotificationRuleContact[]
  vesselBillingOverrides                   VesselBillingOverride[]
  vesselContacts                           VesselContact[]
  vesselHiddenClientContacts               VesselHiddenClientContact[]
  vesselNotificationOverrides              VesselNotificationOverride[]
  vesselNotificationOverrideContacts       VesselNotificationOverrideContact[]
  vesselNotificationOverrideVesselContacts VesselNotificationOverrideVesselContact[]
  labCategories                            LabCategory[]
  serviceTypes                             ServiceType[]
  registrationFields                       RegistrationField[]
  bottleTypes                              BottleType[]
  products                                 Product[]
  productServiceTypes                      ProductServiceType[]
  productVariants                          ProductVariant[]
  productBottles                           ProductBottle[]
  variantBottles                           VariantBottle[]

  airwayBills  AirwayBill[]
  receivedKits ReceivedKit[]

  registrationBatches RegistrationBatch[]
  samples             Sample[]

  testParameters TestParameter[]
  sampleResults  SampleResult[]

  files             StoredFile[]
  labReports        LabReport[]
  labReportVersions LabReportVersion[]
  labReportSamples  LabReportSample[]
  sampleAttachments SampleAttachment[]

  labReportReviews LabReportReview[]

  notifications          Notification[]
  notificationDeliveries NotificationDelivery[]

  @@map("tenants")
}

/// A licensed (enabled) optional module for a tenant. Keys come from MODULES in @flux/shared.
model TenantModule {
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleKey String   @map("module_key")
  enabledAt DateTime @default(now()) @map("enabled_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleKey])
  @@map("tenant_modules")
}

// ─── Identity (M2) ──────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Stored trimmed and lower-cased; uniqueness is therefore case-insensitive.
  email           String     @unique
  name            String
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(ACTIVE)
  /// The user's tenant. NULL only for platform administrators (enforced by a CHECK constraint).
  tenantId        String?    @map("tenant_id") @db.Uuid
  /// Platform operator: manages tenants, belongs to no tenant.
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  /// Client portal user (M18): sees this client's records only; never has roles (trigger).
  clientId        String?    @map("client_id") @db.Uuid
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client    Client?    @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: NoAction)
  sessions  Session[]
  userRoles UserRole[]

  /// Target for composite foreign keys that pin child rows to the same tenant.
  receivedKits ReceivedKit[]

  registeredBatches RegistrationBatch[]

  enteredResults SampleResult[]

  uploadedFiles StoredFile[]

  reportReviews LabReportReview[]

  publishedReports LabReport[] @relation("PublishedReports")

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([clientId])
  @@map("users")
}

/// Server-side session. The cookie carries a random token; only its SHA-256 hash is stored.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  /// Absolute expiry; idle expiry is computed from lastSeenAt.
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Access control (M3b) ───────────────────────────────────────────────────
// Permission, module and portal keys come from the catalogue in @flux/shared.
// Child tables carry tenant_id and composite FKs (…, tenant_id) so a row can never
// link records of two different tenants.

enum Portal {
  ADMIN
  LAB
  CLIENT
  FINANCE
}

/// A tenant-defined role. Exactly one per tenant is the built-in Administrator (is_system).
model Role {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// Unique per tenant, case-insensitively (expression index in the migration).
  name          String
  description   String?
  defaultPortal Portal   @map("default_portal")
  isActive      Boolean  @default(true) @map("is_active")
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portals     RolePortal[]
  modules     RoleModule[]
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("roles")
}

model RolePortal {
  tenantId String @map("tenant_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid
  portal   Portal

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([roleId, portal])
  @@index([tenantId])
  @@map("role_portals")
}

model RoleModule {
  tenantId  String @map("tenant_id") @db.Uuid
  roleId    String @map("role_id") @db.Uuid
  moduleKey String @map("module_key")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([roleId, moduleKey])
  @@index([tenantId])
  @@map("role_modules")
}

model RolePermission {
  tenantId      String @map("tenant_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")
  /// Who assigned it (a user of the same tenant, or null for system/platform actions).
  assignedById String?  @map("assigned_by_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([tenantId])
  @@map("user_roles")
}

// ─── Audit log (M3d) ────────────────────────────────────────────────────────

enum AuditActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
}

/// Append-only record of significant changes. Written in the same transaction as the change.
/// A trigger rejects UPDATE and DELETE for everyone; the app role may only SELECT and INSERT.
model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  /// NULL for platform-level entries (e.g. FLUX default reference data); invisible to tenants.
  tenantId    String?        @map("tenant_id") @db.Uuid
  occurredAt  DateTime       @default(now()) @map("occurred_at")
  /// Snapshot of the actor; no foreign key, so history never depends on other rows.
  actorType   AuditActorType @map("actor_type")
  actorId     String?        @map("actor_id") @db.Uuid
  actorName   String?        @map("actor_name")
  actorEmail  String?        @map("actor_email")
  /// Dotted action key, e.g. "role.permissions_changed" (labels in @flux/shared).
  action      String
  entityType  String         @map("entity_type")
  entityId    String         @map("entity_id") @db.Uuid
  /// Name of the entity at the time, so entries stay readable after renames.
  entityLabel String?        @map("entity_label")
  /// Other entities affected (e.g. the roles in a user's role change), for per-entity history.
  relatedIds  String[]       @default([]) @map("related_ids") @db.Uuid
  /// { field: { from, to } } and/or { added: [...], removed: [...] }. Never secrets.
  changes     Json?
  requestId   String?        @map("request_id")
  ipAddress   String?        @map("ip_address")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([entityId])
  @@index([relatedIds], type: Gin)
  @@map("audit_logs")
}

// ─── Reference data (M4) ────────────────────────────────────────────────────
// Hybrid: rows with tenant_id NULL are FLUX defaults (managed by platform admins, readable by
// every tenant); rows with a tenant_id are that tenant's own items. List keys come from
// REFERENCE_LISTS in @flux/shared, so new lists need no migration.

model ReferenceItem {
  id          String   @id @default(uuid()) @db.Uuid
  /// NULL = FLUX default shared by every tenant.
  tenantId    String?  @map("tenant_id") @db.Uuid
  listKey     String   @map("list_key")
  /// Unique per list and scope, case-insensitively (expression indexes in the migration).
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  /// Items are deactivated, never deleted, because records will reference them.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant              Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hiddenBy            ReferenceItemHidden[]
  vesselsByType       Vessel[]                   @relation("VesselType")
  vesselsByClass      Vessel[]                   @relation("VesselClass")
  relationshipsByType VesselClientRelationship[] @relation("RelationshipType")

  /// Lets domain tables use a typed composite FK (item id + list key), e.g. vessel → vessel-type.
  @@unique([id, listKey])
  @@index([listKey, tenantId])
  @@map("reference_items")
}

/// A FLUX default that a tenant has chosen not to use (hidden from its dropdowns).
model ReferenceItemHidden {
  tenantId String   @map("tenant_id") @db.Uuid
  itemId   String   @map("item_id") @db.Uuid
  hiddenAt DateTime @default(now()) @map("hidden_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   ReferenceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([tenantId, itemId])
  @@map("reference_item_hidden")
}

// ─── Numbering (M5) ─────────────────────────────────────────────────────────

/// Per-tenant counters for human-readable codes (client CL-00001; later vessels, batches,
/// samples). Incremented inside the caller's transaction, so numbers never repeat and failed
/// saves leave no gaps.
model TenantSequence {
  tenantId  String @map("tenant_id") @db.Uuid
  key       String
  nextValue Int    @map("next_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_sequences")
}

// ─── Clients (M5) ───────────────────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum AddressType {
  REGISTERED
  BILLING
  SHIPPING
  OTHER
}

model Client {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  /// Generated per tenant: CL-00001.
  code         String
  name         String
  tradingName  String?      @map("trading_name")
  email        String?
  phone        String?
  website      String?
  taxNumber    String?      @map("tax_number")
  notes        String?
  /// Tenant-defined fields { key: value }, validated against custom_field_definitions.
  customFields Json         @default("{}") @map("custom_fields")
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  addresses      ClientAddress[]
  contacts       ClientContact[]
  billingParties BillingParty[]

  relationships VesselClientRelationship[]
  fleets        Fleet[]
  fleetVessels  FleetVessel[]

  notificationRules            ClientNotificationRule[]
  notificationRuleContacts     ClientNotificationRuleContact[]
  vesselBillingOverrides       VesselBillingOverride[]
  vesselContacts               VesselContact[]
  vesselHiddenContacts         VesselHiddenClientContact[]
  vesselNotificationOverrides  VesselNotificationOverride[]
  vesselOverrideContacts       VesselNotificationOverrideContact[]
  vesselOverrideVesselContacts VesselNotificationOverrideVesselContact[]

  receivedKits ReceivedKit[]

  samples Sample[]

  portalUsers User[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, name])
  @@map("clients")
}

model ClientAddress {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  clientId   String      @map("client_id") @db.Uuid
  type       AddressType
  label      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?     @map("postal_code")
  country    String
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([clientId])
  @@index([tenantId])
  @@map("client_addresses")
}

model ClientContact {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  name      String
  jobTitle  String?  @map("job_title")
  email     String?
  phone     String?
  /// At most one primary contact per client (partial unique index in the migration).
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Cascade)

  hiddenOnVessels       VesselHiddenClientContact[]
  notificationRules     ClientNotificationRuleContact[]
  notificationOverrides VesselNotificationOverrideContact[]

  /// Target for override tables, pinning a contact to the same client.
  @@unique([id, clientId])
  @@index([clientId])
  @@index([tenantId])
  @@map("client_contacts")
}

/// Who is invoiced for a client's work. Deactivated, never deleted (invoices will refer to it).
model BillingParty {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  name       String
  email      String?
  phone      String?
  taxNumber  String?  @map("tax_number")
  line1      String?
  line2      String?
  city       String?
  region     String?
  postalCode String?  @map("postal_code")
  country    String?
  /// At most one default billing party per client (partial unique index in the migration).
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)

  vesselOverrides VesselBillingOverride[]

  @@unique([id, tenantId])
  /// Target for vessel_billing_overrides, pinning the party to the relationship's client.
  @@unique([id, clientId])
  @@index([clientId])
  @@index([tenantId])
  @@map("billing_parties")
}

// ─── Custom fields (M5b) ────────────────────────────────────────────────────

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

/// A tenant-defined field on a record type (entity). Values live in the record's
/// custom_fields JSON column under `key`. key, entity and type never change after creation.
model CustomFieldDefinition {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  entity    String
  key       String
  label     String
  type      CustomFieldType
  required  Boolean         @default(false)
  helpText  String?         @map("help_text")
  /// [{ value, label }] for SELECT fields.
  options   Json            @default("[]")
  sortOrder Int             @default(0) @map("sort_order")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, entity, key])
  @@index([tenantId, entity])
  @@map("custom_field_definitions")
}

// ─── Vessels (M6) ───────────────────────────────────────────────────────────

enum VesselStatus {
  ACTIVE
  INACTIVE
}

/// The vessel master record (design pack §14): independent of clients; client relationships and
/// fleets attach to it later (M7), so one physical vessel is never duplicated per client.
model Vessel {
  id                        String       @id @default(uuid()) @db.Uuid
  tenantId                  String       @map("tenant_id") @db.Uuid
  /// Generated per tenant: VS-00001.
  code                      String
  name                      String
  /// 7 digits, check digit validated; unique per tenant when present.
  imoNumber                 String?      @map("imo_number")
  previousName              String?      @map("previous_name")
  callSign                  String?      @map("call_sign")
  /// Typed reference: (id, list) must exist in reference_items with list_key 'vessel-type'.
  vesselTypeId              String?      @map("vessel_type_id") @db.Uuid
  vesselTypeList            String       @default("vessel-type") @map("vessel_type_list")
  classificationSocietyId   String?      @map("classification_society_id") @db.Uuid
  classificationSocietyList String       @default("classification-society") @map("classification_society_list")
  yearBuilt                 Int?         @map("year_built")
  grossTonnage              Int?         @map("gross_tonnage")
  deadweight                Int?
  customFields              Json         @default("{}") @map("custom_fields")
  status                    VesselStatus @default(ACTIVE)
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vesselType            ReferenceItem? @relation("VesselType", fields: [vesselTypeId, vesselTypeList], references: [id, listKey], onDelete: Restrict)
  classificationSociety ReferenceItem? @relation("VesselClass", fields: [classificationSocietyId, classificationSocietyList], references: [id, listKey], onDelete: Restrict)

  relationships VesselClientRelationship[]

  receivedKits ReceivedKit[]

  samples Sample[]

  @@unique([tenantId, code])
  @@unique([tenantId, imoNumber])
  @@unique([id, tenantId])
  @@index([tenantId, name])
  @@map("vessels")
}

// ─── Vessel–client relationships and fleets (M7) ────────────────────────────
// Design pack §14: one vessel master, linked to clients through relationships; fleets belong to
// a client and a vessel joins a fleet through its relationship with that client.

enum RelationshipStatus {
  ACTIVE
  ENDED
}

enum FleetStatus {
  ACTIVE
  INACTIVE
}

model VesselClientRelationship {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  vesselId             String             @map("vessel_id") @db.Uuid
  clientId             String             @map("client_id") @db.Uuid
  relationshipTypeId   String             @map("relationship_type_id") @db.Uuid
  relationshipTypeList String             @default("vessel-relationship-type") @map("relationship_type_list")
  /// At most one active primary relationship per vessel (partial unique index).
  isPrimary            Boolean            @default(false) @map("is_primary")
  status               RelationshipStatus @default(ACTIVE)
  startDate            DateTime?          @map("start_date") @db.Date
  endDate              DateTime?          @map("end_date") @db.Date
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vessel           Vessel        @relation(fields: [vesselId, tenantId], references: [id, tenantId], onDelete: Restrict)
  client           Client        @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  relationshipType ReferenceItem @relation("RelationshipType", fields: [relationshipTypeId, relationshipTypeList], references: [id, listKey], onDelete: Restrict)
  fleetMemberships FleetVessel[]

  billingOverrides      VesselBillingOverride[]
  vesselContacts        VesselContact[]
  hiddenClientContacts  VesselHiddenClientContact[]
  notificationOverrides VesselNotificationOverride[]

  @@unique([id, tenantId])
  /// Target for fleet_vessels, pinning a membership to this relationship's vessel and client.
  @@unique([id, vesselId, clientId])
  @@index([vesselId])
  @@index([clientId])
  @@map("vessel_client_relationships")
}

model Fleet {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  clientId  String      @map("client_id") @db.Uuid
  /// Generated per tenant: FL-00001.
  code      String
  /// Unique per client, ignoring case (expression index).
  name      String
  status    FleetStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client  Client        @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  members FleetVessel[]

  @@unique([tenantId, code])
  /// Target for fleet_vessels, pinning a membership to this fleet's client.
  @@unique([id, clientId])
  @@index([clientId])
  @@map("fleets")
}

/// A vessel in a fleet, through its relationship with the fleet's client. Composite FKs make the
/// fleet and the relationship belong to the same client; removed_at keeps history.
model FleetVessel {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  fleetId        String    @map("fleet_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  vesselId       String    @map("vessel_id") @db.Uuid
  relationshipId String    @map("relationship_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  removedAt      DateTime? @map("removed_at")

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client       Client                   @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  fleet        Fleet                    @relation(fields: [fleetId, clientId], references: [id, clientId], onDelete: Restrict, onUpdate: NoAction)
  relationship VesselClientRelationship @relation(fields: [relationshipId, vesselId, clientId], references: [id, vesselId, clientId], onDelete: Restrict, onUpdate: NoAction)

  @@index([fleetId])
  @@index([relationshipId])
  @@map("fleet_vessels")
}

// ─── Notifications and vessel overrides (M8) ────────────────────────────────
// Design pack §15: client settings are the default; a vessel stores only its overrides, per
// vessel–client relationship. Every table carries client_id: composite FKs pin parties, contacts
// and relationships to that one client, and (client_id, tenant_id) pins the client to the tenant.

/// The client's rule for one notification event (keys: NOTIFICATION_EVENTS in @flux/shared).
model ClientNotificationRule {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  event       String
  enabled     Boolean  @default(false)
  /// Extra recipients that are not contacts.
  extraEmails String[] @default([]) @map("extra_emails")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client   Client                          @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  contacts ClientNotificationRuleContact[]

  @@unique([clientId, event])
  @@unique([id, clientId])
  @@map("client_notification_rules")
}

model ClientNotificationRuleContact {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  clientId  String @map("client_id") @db.Uuid
  ruleId    String @map("rule_id") @db.Uuid
  contactId String @map("contact_id") @db.Uuid

  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client  Client                 @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  rule    ClientNotificationRule @relation(fields: [ruleId, clientId], references: [id, clientId], onDelete: Cascade, onUpdate: NoAction)
  contact ClientContact          @relation(fields: [contactId, clientId], references: [id, clientId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([ruleId, contactId])
  @@index([contactId])
  @@map("client_notification_rule_contacts")
}

/// The client billing party invoiced for this vessel instead of the client's default.
model VesselBillingOverride {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  relationshipId String   @unique @map("relationship_id") @db.Uuid
  vesselId       String   @map("vessel_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  billingPartyId String   @map("billing_party_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client       Client                   @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  relationship VesselClientRelationship @relation(fields: [relationshipId, vesselId, clientId], references: [id, vesselId, clientId], onDelete: Restrict, onUpdate: NoAction)
  billingParty BillingParty             @relation(fields: [billingPartyId, clientId], references: [id, clientId], onDelete: Restrict, onUpdate: NoAction)

  @@index([billingPartyId])
  @@map("vessel_billing_overrides")
}

/// A contact for this vessel only (e.g. master, chief engineer), under one client relationship.
model VesselContact {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  relationshipId String   @map("relationship_id") @db.Uuid
  vesselId       String   @map("vessel_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  name           String
  jobTitle       String?  @map("job_title")
  email          String?
  phone          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant                Tenant                                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client                Client                                    @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  relationship          VesselClientRelationship                  @relation(fields: [relationshipId, vesselId, clientId], references: [id, vesselId, clientId], onDelete: Restrict, onUpdate: NoAction)
  notificationOverrides VesselNotificationOverrideVesselContact[]

  /// Target for override recipients, pinning the contact to the same relationship.
  @@unique([id, relationshipId])
  @@index([relationshipId])
  @@map("vessel_contacts")
}

/// A client contact that does not apply to this vessel (also dropped from inherited recipients).
model VesselHiddenClientContact {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  relationshipId String   @map("relationship_id") @db.Uuid
  vesselId       String   @map("vessel_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client       Client                   @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  relationship VesselClientRelationship @relation(fields: [relationshipId, vesselId, clientId], references: [id, vesselId, clientId], onDelete: Restrict, onUpdate: NoAction)
  contact      ClientContact            @relation(fields: [contactId, clientId], references: [id, clientId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([relationshipId, contactId])
  @@index([contactId])
  @@map("vessel_hidden_client_contacts")
}

/// What this vessel changes about the client's rule for one event; only changed parts are set.
model VesselNotificationOverride {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  relationshipId   String   @map("relationship_id") @db.Uuid
  vesselId         String   @map("vessel_id") @db.Uuid
  clientId         String   @map("client_id") @db.Uuid
  event            String
  /// null: on/off as the client's rule.
  enabled          Boolean?
  /// false: the client's recipients; true: this override's contacts and extra emails.
  customRecipients Boolean  @default(false) @map("custom_recipients")
  extraEmails      String[] @default([]) @map("extra_emails")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant                                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client         Client                                    @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  relationship   VesselClientRelationship                  @relation(fields: [relationshipId, vesselId, clientId], references: [id, vesselId, clientId], onDelete: Restrict, onUpdate: NoAction)
  clientContacts VesselNotificationOverrideContact[]
  vesselContacts VesselNotificationOverrideVesselContact[]

  @@unique([relationshipId, event])
  @@unique([id, relationshipId, clientId])
  @@map("vessel_notification_overrides")
}

model VesselNotificationOverrideContact {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  overrideId     String @map("override_id") @db.Uuid
  relationshipId String @map("relationship_id") @db.Uuid
  clientId       String @map("client_id") @db.Uuid
  contactId      String @map("contact_id") @db.Uuid

  tenant   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client   Client                     @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  override VesselNotificationOverride @relation(fields: [overrideId, relationshipId, clientId], references: [id, relationshipId, clientId], onDelete: Cascade, onUpdate: NoAction)
  contact  ClientContact              @relation(fields: [contactId, clientId], references: [id, clientId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([overrideId, contactId])
  @@index([contactId])
  @@map("vessel_notification_override_contacts")
}

model VesselNotificationOverrideVesselContact {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  overrideId     String @map("override_id") @db.Uuid
  relationshipId String @map("relationship_id") @db.Uuid
  clientId       String @map("client_id") @db.Uuid
  contactId      String @map("vessel_contact_id") @db.Uuid

  tenant   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client   Client                     @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  override VesselNotificationOverride @relation(fields: [overrideId, relationshipId, clientId], references: [id, relationshipId, clientId], onDelete: Cascade, onUpdate: NoAction)
  contact  VesselContact              @relation(fields: [contactId, relationshipId], references: [id, relationshipId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([overrideId, contactId])
  @@index([contactId])
  @@map("vessel_notification_override_vessel_contacts")
}

// ─── Laboratory master data (M9) ────────────────────────────────────────────
// Design pack §7: Category → Service Type → Product/Kit → Variant → Bottle configuration.
// Codes are upper-case and unique per tenant (per kit for variants). Nothing is deleted except
// link rows (kit ↔ service type, bottle lines): records are deactivated. Every relation is a
// composite FK including tenant_id, so a link can never cross organisations.

enum RegistrationFieldScope {
  BATCH
  SAMPLE
}

model LabCategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  serviceTypes ServiceType[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("lab_categories")
}

/// What is tested (e.g. Ballast Water). Defines the fields entered when registering samples.
model ServiceType {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  code           String
  name           String
  description    String?
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  /// Samples of this type need a vessel at registration.
  vesselRequired Boolean  @default(false) @map("vessel_required")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category LabCategory          @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  fields   RegistrationField[]
  products ProductServiceType[]

  receivedKits ReceivedKit[]

  batches RegistrationBatch[]
  samples Sample[]

  parameters TestParameter[]

  labReports LabReport[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([categoryId])
  @@map("service_types")
}

/// A field entered at registration ("Registration fields 1, 2, 3…"), once per batch or per sample.
/// key, type and scope never change after creation.
model RegistrationField {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  serviceTypeId String                 @map("service_type_id") @db.Uuid
  key           String
  label         String
  type          CustomFieldType
  scope         RegistrationFieldScope
  required      Boolean                @default(false)
  helpText      String?                @map("help_text")
  /// [{ value, label }] for SELECT fields.
  options       Json                   @default("[]")
  sortOrder     Int                    @default(0) @map("sort_order")
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  serviceType ServiceType @relation(fields: [serviceTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([serviceTypeId, key])
  @@map("service_type_fields")
}

model BottleType {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  volumeMl  Int      @map("volume_ml")
  material  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productBottles ProductBottle[]
  variantBottles VariantBottle[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("bottle_types")
}

/// A sampling kit (product), usable for one or more service types.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  serviceTypes ProductServiceType[]
  variants     ProductVariant[]
  bottles      ProductBottle[]

  receivedKits ReceivedKit[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("products")
}

model ProductServiceType {
  tenantId      String @map("tenant_id") @db.Uuid
  productId     String @map("product_id") @db.Uuid
  serviceTypeId String @map("service_type_id") @db.Uuid

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  serviceType ServiceType @relation(fields: [serviceTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([productId, serviceTypeId])
  @@index([serviceTypeId])
  @@map("product_service_types")
}

/// A kit variant (e.g. UV, Electrolysis, Ozone). Uses the kit's bottles unless it has its own.
model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product         @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  bottles VariantBottle[]

  receivedKits ReceivedKit[]

  /// Target for received_kits, pinning a variant to the received kit's product.
  @@unique([id, productId])
  @@unique([productId, code])
  @@unique([id, tenantId])
  @@map("product_variants")
}

/// Bottles in a kit (product_bottle_configs in the design pack).
model ProductBottle {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  bottleTypeId String @map("bottle_type_id") @db.Uuid
  quantity     Int

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  bottleType BottleType @relation(fields: [bottleTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([productId, bottleTypeId])
  @@index([bottleTypeId])
  @@map("product_bottle_configs")
}

/// A variant's own bottles; when present they replace the kit's list for that variant.
model VariantBottle {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  variantId    String @map("variant_id") @db.Uuid
  bottleTypeId String @map("bottle_type_id") @db.Uuid
  quantity     Int

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  variant    ProductVariant @relation(fields: [variantId, tenantId], references: [id, tenantId], onDelete: Cascade)
  bottleType BottleType     @relation(fields: [bottleTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([variantId, bottleTypeId])
  @@index([bottleTypeId])
  @@map("variant_bottle_configs")
}

// ─── Receiving (M10) ────────────────────────────────────────────────────────
// Design pack §8 Bulk Receiving: an Airway Bill (the shipment) and the kits received under it,
// one by one. A kit waits in the registration queue until it is registered (M11).

enum AirwayBillStatus {
  OPEN
  CLOSED
}

enum KitCondition {
  OK
  DAMAGED
  LEAKING
  INCOMPLETE
}

enum ReceivedKitStatus {
  PENDING_REGISTRATION
  REGISTERED
  CANCELLED
}

model AirwayBill {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  /// Normalised: upper case, no spaces. Unique per tenant.
  number     String
  courier    String?
  origin     String?
  receivedOn DateTime         @map("received_on") @db.Date
  notes      String?
  status     AirwayBillStatus @default(OPEN)
  closedAt   DateTime?        @map("closed_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  kits   ReceivedKit[]

  @@unique([tenantId, number])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("airway_bills")
}

model ReceivedKit {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  /// Generated per tenant: RK-000001.
  code           String
  airwayBillId   String            @map("airway_bill_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  variantId      String?           @map("variant_id") @db.Uuid
  /// Printed on the kit; unique per tenant among kits that are not cancelled (partial index).
  serialNumber   String?           @map("serial_number")
  serviceTypeId  String?           @map("service_type_id") @db.Uuid
  clientId       String?           @map("client_id") @db.Uuid
  vesselId       String?           @map("vessel_id") @db.Uuid
  condition      KitCondition      @default(OK)
  conditionNotes String?           @map("condition_notes")
  status         ReceivedKitStatus @default(PENDING_REGISTRATION)
  cancelReason   String?           @map("cancel_reason")
  receivedAt     DateTime          @default(now()) @map("received_at")
  receivedById   String?           @map("received_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  airwayBill  AirwayBill      @relation(fields: [airwayBillId, tenantId], references: [id, tenantId], onDelete: Restrict)
  product     Product         @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict, onUpdate: NoAction)
  serviceType ServiceType?    @relation(fields: [serviceTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  client      Client?         @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  vessel      Vessel?         @relation(fields: [vesselId, tenantId], references: [id, tenantId], onDelete: Restrict)
  receivedBy  User?           @relation(fields: [receivedById], references: [id], onDelete: SetNull)

  samples Sample[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([airwayBillId])
  @@index([vesselId])
  @@index([clientId])
  @@map("received_kits")
}

// ─── Batch registration (M11) ───────────────────────────────────────────────
// Design pack §8/§16/§20: selected received kits become a batch (one service type) with one
// sample per kit, in one transaction. Codes are per tenant and year: B26-00001, S26-000001.

enum SampleStatus {
  REGISTERED
  UNDER_TESTING
  RESULTS_ENTERED
}

model RegistrationBatch {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  code           String
  serviceTypeId  String   @map("service_type_id") @db.Uuid
  /// Values of the service type's batch fields, by field key.
  values         Json     @default("{}")
  notes          String?
  registeredAt   DateTime @default(now()) @map("registered_at")
  registeredById String?  @map("registered_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  serviceType  ServiceType @relation(fields: [serviceTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  registeredBy User?       @relation(fields: [registeredById], references: [id], onDelete: SetNull)
  samples      Sample[]

  labReports LabReport[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  /// Target for samples, pinning each sample to its batch's service type.
  @@unique([id, serviceTypeId])
  @@index([tenantId, registeredAt])
  @@map("registration_batches")
}

model Sample {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  code               String
  batchId            String       @map("batch_id") @db.Uuid
  serviceTypeId      String       @map("service_type_id") @db.Uuid
  /// One sample per received kit (also stops a kit being registered twice).
  receivedKitId      String       @unique @map("received_kit_id") @db.Uuid
  clientId           String       @map("client_id") @db.Uuid
  vesselId           String?      @map("vessel_id") @db.Uuid
  /// Values of the service type's sample fields, by field key.
  values             Json         @default("{}")
  status             SampleStatus @default(REGISTERED)
  registeredAt       DateTime     @default(now()) @map("registered_at")
  testingStartedAt   DateTime?    @map("testing_started_at")
  resultsCompletedAt DateTime?    @map("results_completed_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batch       RegistrationBatch @relation(fields: [batchId, serviceTypeId], references: [id, serviceTypeId], onDelete: Restrict, onUpdate: NoAction)
  serviceType ServiceType       @relation(fields: [serviceTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  receivedKit ReceivedKit       @relation(fields: [receivedKitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  client      Client            @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  vessel      Vessel?           @relation(fields: [vesselId, tenantId], references: [id, tenantId], onDelete: Restrict)

  results SampleResult[]

  /// Target for sample_results, pinning a result's parameter to the sample's service type.
  labReportLinks LabReportSample[]
  attachments    SampleAttachment[]

  /// Target for lab_report_samples, pinning a covered sample to the report's batch.
  @@unique([id, batchId])
  @@unique([id, tenantId])
  @@unique([id, serviceTypeId])
  @@unique([tenantId, code])
  @@index([batchId])
  @@index([tenantId, status])
  @@index([clientId])
  @@index([vesselId])
  @@map("samples")
}

// ─── Testing and results (M13) ──────────────────────────────────────────────
// Design pack §8 Under Testing: structured results per test parameter. Parameters belong to a
// service type; a result's composite FKs pin its parameter to the sample's service type.

enum ParameterType {
  NUMBER
  TEXT
  PASS_FAIL
  CHOICE
}

enum ResultFlag {
  NORMAL
  CAUTION
  CRITICAL
}

model TestParameter {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  serviceTypeId String        @map("service_type_id") @db.Uuid
  /// Stable identifier (CSV column); key and type never change.
  key           String
  name          String
  unit          String?
  type          ParameterType
  decimals      Int?
  method        String?
  /// CHOICE: allowed answers (JSON array of strings).
  options       Json          @default("[]")
  cautionMin    Float?        @map("caution_min")
  cautionMax    Float?        @map("caution_max")
  criticalMin   Float?        @map("critical_min")
  criticalMax   Float?        @map("critical_max")
  required      Boolean       @default(false)
  sortOrder     Int           @default(0) @map("sort_order")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  serviceType ServiceType    @relation(fields: [serviceTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  results     SampleResult[]

  @@unique([serviceTypeId, key])
  /// Target for sample_results: same service type and same tenant as the result.
  @@unique([id, serviceTypeId, tenantId])
  @@map("test_parameters")
}

/// One value per sample and parameter. value_number for NUMBER, value_boolean for PASS_FAIL,
/// value_text for TEXT/CHOICE. The flag is computed from the limits when the value is saved.
model SampleResult {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  sampleId      String      @map("sample_id") @db.Uuid
  serviceTypeId String      @map("service_type_id") @db.Uuid
  parameterId   String      @map("parameter_id") @db.Uuid
  valueNumber   Float?      @map("value_number")
  valueText     String?     @map("value_text")
  valueBoolean  Boolean?    @map("value_boolean")
  flag          ResultFlag?
  enteredAt     DateTime    @default(now()) @map("entered_at")
  enteredById   String?     @map("entered_by_id") @db.Uuid
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sample    Sample        @relation(fields: [sampleId, serviceTypeId], references: [id, serviceTypeId], onDelete: Restrict, onUpdate: NoAction)
  parameter TestParameter @relation(fields: [parameterId, serviceTypeId, tenantId], references: [id, serviceTypeId, tenantId], onDelete: Restrict, onUpdate: NoAction)
  enteredBy User?         @relation(fields: [enteredById], references: [id], onDelete: SetNull)

  @@unique([sampleId, parameterId])
  @@index([parameterId])
  @@map("sample_results")
}

// ─── Files and lab reports (M14) ────────────────────────────────────────────
// Design pack §20: staged uploads to private storage (the database keeps metadata and the
// object key). Lab reports cover one or more samples of one batch; each upload is a version.

enum FilePurpose {
  LAB_REPORT
  FINAL_REPORT
  RESULT_ATTACHMENT
}

enum FileStatus {
  PENDING
  READY
}

enum LabReportStatus {
  SUBMITTED
  REJECTED
  READY_TO_PUBLISH
  PUBLISHED
}

model StoredFile {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  purpose      FilePurpose
  status       FileStatus  @default(PENDING)
  /// Original file name (sanitised), shown and used for downloads.
  name         String
  /// Declared at intent; the stored size once uploaded.
  size         Int
  /// Detected from the content on upload.
  contentType  String?     @map("content_type")
  sha256       String?
  /// Object key in storage: <tenant>/<file id>.
  storageKey   String      @map("storage_key")
  uploadedById String?     @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")
  uploadedAt   DateTime?   @map("uploaded_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  uploadedBy     User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  reportVersions LabReportVersion[]
  attachments    SampleAttachment[]

  finalReports  LabReport[]    @relation("FinalReport")
  notifications Notification[]

  @@unique([id, tenantId])
  @@unique([storageKey])
  @@index([tenantId, status])
  @@map("files")
}

model LabReport {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  code           String
  batchId        String          @map("batch_id") @db.Uuid
  serviceTypeId  String          @map("service_type_id") @db.Uuid
  status         LabReportStatus @default(SUBMITTED)
  currentVersion Int             @default(1) @map("current_version")
  submittedAt    DateTime        @default(now()) @map("submitted_at")
  /// Publishing (M16): the final report released to the client.
  finalFileId    String?         @unique @map("final_file_id") @db.Uuid
  publishedAt    DateTime?       @map("published_at")
  publishedById  String?         @map("published_by_id") @db.Uuid
  publishNote    String?         @map("publish_note")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batch         RegistrationBatch  @relation(fields: [batchId, serviceTypeId], references: [id, serviceTypeId], onDelete: Restrict, onUpdate: NoAction)
  serviceType   ServiceType        @relation(fields: [serviceTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  versions      LabReportVersion[]
  finalFile     StoredFile?        @relation("FinalReport", fields: [finalFileId, tenantId], references: [id, tenantId], onDelete: Restrict)
  publishedBy   User?              @relation("PublishedReports", fields: [publishedById], references: [id], onDelete: SetNull)
  notifications Notification[]
  samples       LabReportSample[]

  reviews LabReportReview[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  /// Target for lab_report_samples.
  @@unique([id, batchId])
  @@index([tenantId, status])
  @@index([batchId])
  @@map("lab_reports")
}

model LabReportVersion {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  reportId     String   @map("report_id") @db.Uuid
  version      Int
  fileId       String   @unique @map("file_id") @db.Uuid
  note         String?
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report LabReport  @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Restrict)
  file   StoredFile @relation(fields: [fileId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([reportId, version])
  @@map("lab_report_versions")
}

/// Which samples a report covers; a sample is in at most one report.
model LabReportSample {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  reportId String @map("report_id") @db.Uuid
  batchId  String @map("batch_id") @db.Uuid
  sampleId String @unique @map("sample_id") @db.Uuid

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report LabReport @relation(fields: [reportId, batchId], references: [id, batchId], onDelete: Restrict, onUpdate: NoAction)
  sample Sample    @relation(fields: [sampleId, batchId], references: [id, batchId], onDelete: Restrict, onUpdate: NoAction)

  @@index([reportId])
  @@map("lab_report_samples")
}

model SampleAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sampleId  String   @map("sample_id") @db.Uuid
  fileId    String   @unique @map("file_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sample Sample     @relation(fields: [sampleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  file   StoredFile @relation(fields: [fileId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([sampleId])
  @@map("sample_attachments")
}

// ─── Admin review (M15) ─────────────────────────────────────────────────────
// Design pack §8/§16: Admin reviews a submitted lab report and rejects it (comment required, back
// to the lab) or marks it ready to publish; a ready report can be sent back with a reason.

enum ReviewDecision {
  REJECTED
  READY_TO_PUBLISH
  REOPENED
}

model LabReportReview {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  reportId   String         @map("report_id") @db.Uuid
  /// The report version the decision was about.
  version    Int
  decision   ReviewDecision
  comment    String?
  reviewerId String?        @map("reviewer_id") @db.Uuid
  decidedAt  DateTime       @default(now()) @map("decided_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report   LabReport @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reviewer User?     @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([reportId, decidedAt])
  @@map("lab_report_reviews")
}

// ─── Publishing and notifications (M16) ─────────────────────────────────────
// Design pack §9/§20: publishing a ready report releases the final PDF and turns its samples
// green. The emails it causes are written here in the same transaction (an outbox) and sent by a
// background worker, which records every delivery (notification_deliveries).

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model Notification {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  /// Event key (NOTIFICATION_EVENTS in @flux/shared), e.g. report.published.
  event            String
  reportId         String   @map("report_id") @db.Uuid
  clientName       String   @map("client_name")
  vesselName       String?  @map("vessel_name")
  sampleCodes      String[] @map("sample_codes")
  subject          String
  bodyText         String   @map("body_text")
  bodyHtml         String   @map("body_html")
  attachmentFileId String?  @map("attachment_file_id") @db.Uuid
  /// Set when nothing was sent (rule off, no recipients with an address).
  skippedReason    String?  @map("skipped_reason")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report     LabReport              @relation(fields: [reportId, tenantId], references: [id, tenantId], onDelete: Restrict)
  attachment StoredFile?            @relation(fields: [attachmentFileId, tenantId], references: [id, tenantId], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@unique([id, tenantId])
  @@index([reportId])
  @@map("notifications")
}

model NotificationDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  notificationId String         @map("notification_id") @db.Uuid
  email          String
  name           String?
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  lastError      String?        @map("last_error")
  nextAttemptAt  DateTime       @default(now()) @map("next_attempt_at")
  sentAt         DateTime?      @map("sent_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notification Notification @relation(fields: [notificationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([notificationId, email])
  /// The worker's queue scan.
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}
