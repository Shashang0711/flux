// FLUX database schema.
// Domain models are added milestone by milestone (M2 users, M3 roles/permissions/audit, ...).
// Conventions:
//   - UUID primary keys; human-readable business codes as separate @unique columns.
//   - Workflow states are Prisma enums, never free-text strings.
//   - snake_case table/column names via @@map / @map; camelCase in TypeScript.
//   - Multi-tenancy: every tenant-owned table has tenant_id, a row-level security policy using
//     app_current_tenant(), and explicit grants to the flux_app role (see README, "Tenancy").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy (M3a) ──────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// A company subscribed to FLUX. All tenant-owned data is isolated by tenant_id + RLS.
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  /// URL-safe identifier, unique across the platform.
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  modules         TenantModule[]
  users           User[]
  roles           Role[]
  rolePortals     RolePortal[]
  roleModules     RoleModule[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  auditLogs       AuditLog[]
  referenceItems  ReferenceItem[]
  hiddenReference ReferenceItemHidden[]
  sequences       TenantSequence[]
  clients         Client[]
  clientAddresses ClientAddress[]
  clientContacts  ClientContact[]
  billingParties  BillingParty[]
  customFields    CustomFieldDefinition[]
  vessels         Vessel[]
  relationships   VesselClientRelationship[]
  fleets          Fleet[]
  fleetVessels    FleetVessel[]

  @@map("tenants")
}

/// A licensed (enabled) optional module for a tenant. Keys come from MODULES in @flux/shared.
model TenantModule {
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleKey String   @map("module_key")
  enabledAt DateTime @default(now()) @map("enabled_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleKey])
  @@map("tenant_modules")
}

// ─── Identity (M2) ──────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Stored trimmed and lower-cased; uniqueness is therefore case-insensitive.
  email           String     @unique
  name            String
  passwordHash    String     @map("password_hash")
  status          UserStatus @default(ACTIVE)
  /// The user's tenant. NULL only for platform administrators (enforced by a CHECK constraint).
  tenantId        String?    @map("tenant_id") @db.Uuid
  /// Platform operator: manages tenants, belongs to no tenant.
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions  Session[]
  userRoles UserRole[]

  /// Target for composite foreign keys that pin child rows to the same tenant.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("users")
}

/// Server-side session. The cookie carries a random token; only its SHA-256 hash is stored.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  /// Absolute expiry; idle expiry is computed from lastSeenAt.
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Access control (M3b) ───────────────────────────────────────────────────
// Permission, module and portal keys come from the catalogue in @flux/shared.
// Child tables carry tenant_id and composite FKs (…, tenant_id) so a row can never
// link records of two different tenants.

enum Portal {
  ADMIN
  LAB
  CLIENT
  FINANCE
}

/// A tenant-defined role. Exactly one per tenant is the built-in Administrator (is_system).
model Role {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// Unique per tenant, case-insensitively (expression index in the migration).
  name          String
  description   String?
  defaultPortal Portal   @map("default_portal")
  isActive      Boolean  @default(true) @map("is_active")
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portals     RolePortal[]
  modules     RoleModule[]
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("roles")
}

model RolePortal {
  tenantId String @map("tenant_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid
  portal   Portal

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([roleId, portal])
  @@index([tenantId])
  @@map("role_portals")
}

model RoleModule {
  tenantId  String @map("tenant_id") @db.Uuid
  roleId    String @map("role_id") @db.Uuid
  moduleKey String @map("module_key")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([roleId, moduleKey])
  @@index([tenantId])
  @@map("role_modules")
}

model RolePermission {
  tenantId      String @map("tenant_id") @db.Uuid
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at")
  /// Who assigned it (a user of the same tenant, or null for system/platform actions).
  assignedById String?  @map("assigned_by_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([tenantId])
  @@map("user_roles")
}

// ─── Audit log (M3d) ────────────────────────────────────────────────────────

enum AuditActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
}

/// Append-only record of significant changes. Written in the same transaction as the change.
/// A trigger rejects UPDATE and DELETE for everyone; the app role may only SELECT and INSERT.
model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  /// NULL for platform-level entries (e.g. FLUX default reference data); invisible to tenants.
  tenantId    String?        @map("tenant_id") @db.Uuid
  occurredAt  DateTime       @default(now()) @map("occurred_at")
  /// Snapshot of the actor; no foreign key, so history never depends on other rows.
  actorType   AuditActorType @map("actor_type")
  actorId     String?        @map("actor_id") @db.Uuid
  actorName   String?        @map("actor_name")
  actorEmail  String?        @map("actor_email")
  /// Dotted action key, e.g. "role.permissions_changed" (labels in @flux/shared).
  action      String
  entityType  String         @map("entity_type")
  entityId    String         @map("entity_id") @db.Uuid
  /// Name of the entity at the time, so entries stay readable after renames.
  entityLabel String?        @map("entity_label")
  /// Other entities affected (e.g. the roles in a user's role change), for per-entity history.
  relatedIds  String[]       @default([]) @map("related_ids") @db.Uuid
  /// { field: { from, to } } and/or { added: [...], removed: [...] }. Never secrets.
  changes     Json?
  requestId   String?        @map("request_id")
  ipAddress   String?        @map("ip_address")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([entityId])
  @@index([relatedIds], type: Gin)
  @@map("audit_logs")
}

// ─── Reference data (M4) ────────────────────────────────────────────────────
// Hybrid: rows with tenant_id NULL are FLUX defaults (managed by platform admins, readable by
// every tenant); rows with a tenant_id are that tenant's own items. List keys come from
// REFERENCE_LISTS in @flux/shared, so new lists need no migration.

model ReferenceItem {
  id          String   @id @default(uuid()) @db.Uuid
  /// NULL = FLUX default shared by every tenant.
  tenantId    String?  @map("tenant_id") @db.Uuid
  listKey     String   @map("list_key")
  /// Unique per list and scope, case-insensitively (expression indexes in the migration).
  code        String
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  /// Items are deactivated, never deleted, because records will reference them.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant              Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hiddenBy            ReferenceItemHidden[]
  vesselsByType       Vessel[]                   @relation("VesselType")
  vesselsByClass      Vessel[]                   @relation("VesselClass")
  relationshipsByType VesselClientRelationship[] @relation("RelationshipType")

  /// Lets domain tables use a typed composite FK (item id + list key), e.g. vessel → vessel-type.
  @@unique([id, listKey])
  @@index([listKey, tenantId])
  @@map("reference_items")
}

/// A FLUX default that a tenant has chosen not to use (hidden from its dropdowns).
model ReferenceItemHidden {
  tenantId String   @map("tenant_id") @db.Uuid
  itemId   String   @map("item_id") @db.Uuid
  hiddenAt DateTime @default(now()) @map("hidden_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   ReferenceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([tenantId, itemId])
  @@map("reference_item_hidden")
}

// ─── Numbering (M5) ─────────────────────────────────────────────────────────

/// Per-tenant counters for human-readable codes (client CL-00001; later vessels, batches,
/// samples). Incremented inside the caller's transaction, so numbers never repeat and failed
/// saves leave no gaps.
model TenantSequence {
  tenantId  String @map("tenant_id") @db.Uuid
  key       String
  nextValue Int    @map("next_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_sequences")
}

// ─── Clients (M5) ───────────────────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum AddressType {
  REGISTERED
  BILLING
  SHIPPING
  OTHER
}

model Client {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  /// Generated per tenant: CL-00001.
  code         String
  name         String
  tradingName  String?      @map("trading_name")
  email        String?
  phone        String?
  website      String?
  taxNumber    String?      @map("tax_number")
  notes        String?
  /// Tenant-defined fields { key: value }, validated against custom_field_definitions.
  customFields Json         @default("{}") @map("custom_fields")
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  addresses      ClientAddress[]
  contacts       ClientContact[]
  billingParties BillingParty[]

  relationships VesselClientRelationship[]
  fleets        Fleet[]
  fleetVessels  FleetVessel[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, name])
  @@map("clients")
}

model ClientAddress {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  clientId   String      @map("client_id") @db.Uuid
  type       AddressType
  label      String?
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?     @map("postal_code")
  country    String
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([clientId])
  @@index([tenantId])
  @@map("client_addresses")
}

model ClientContact {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  name      String
  jobTitle  String?  @map("job_title")
  email     String?
  phone     String?
  /// At most one primary contact per client (partial unique index in the migration).
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([clientId])
  @@index([tenantId])
  @@map("client_contacts")
}

/// Who is invoiced for a client's work. Deactivated, never deleted (invoices will refer to it).
model BillingParty {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  name       String
  email      String?
  phone      String?
  taxNumber  String?  @map("tax_number")
  line1      String?
  line2      String?
  city       String?
  region     String?
  postalCode String?  @map("postal_code")
  country    String?
  /// At most one default billing party per client (partial unique index in the migration).
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([clientId])
  @@index([tenantId])
  @@map("billing_parties")
}

// ─── Custom fields (M5b) ────────────────────────────────────────────────────

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

/// A tenant-defined field on a record type (entity). Values live in the record's
/// custom_fields JSON column under `key`. key, entity and type never change after creation.
model CustomFieldDefinition {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  entity    String
  key       String
  label     String
  type      CustomFieldType
  required  Boolean         @default(false)
  helpText  String?         @map("help_text")
  /// [{ value, label }] for SELECT fields.
  options   Json            @default("[]")
  sortOrder Int             @default(0) @map("sort_order")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, entity, key])
  @@index([tenantId, entity])
  @@map("custom_field_definitions")
}

// ─── Vessels (M6) ───────────────────────────────────────────────────────────

enum VesselStatus {
  ACTIVE
  INACTIVE
}

/// The vessel master record (design pack §14): independent of clients; client relationships and
/// fleets attach to it later (M7), so one physical vessel is never duplicated per client.
model Vessel {
  id                        String       @id @default(uuid()) @db.Uuid
  tenantId                  String       @map("tenant_id") @db.Uuid
  /// Generated per tenant: VS-00001.
  code                      String
  name                      String
  /// 7 digits, check digit validated; unique per tenant when present.
  imoNumber                 String?      @map("imo_number")
  previousName              String?      @map("previous_name")
  callSign                  String?      @map("call_sign")
  /// Typed reference: (id, list) must exist in reference_items with list_key 'vessel-type'.
  vesselTypeId              String?      @map("vessel_type_id") @db.Uuid
  vesselTypeList            String       @default("vessel-type") @map("vessel_type_list")
  classificationSocietyId   String?      @map("classification_society_id") @db.Uuid
  classificationSocietyList String       @default("classification-society") @map("classification_society_list")
  yearBuilt                 Int?         @map("year_built")
  grossTonnage              Int?         @map("gross_tonnage")
  deadweight                Int?
  customFields              Json         @default("{}") @map("custom_fields")
  status                    VesselStatus @default(ACTIVE)
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vesselType            ReferenceItem? @relation("VesselType", fields: [vesselTypeId, vesselTypeList], references: [id, listKey], onDelete: Restrict)
  classificationSociety ReferenceItem? @relation("VesselClass", fields: [classificationSocietyId, classificationSocietyList], references: [id, listKey], onDelete: Restrict)

  relationships VesselClientRelationship[]

  @@unique([tenantId, code])
  @@unique([tenantId, imoNumber])
  @@unique([id, tenantId])
  @@index([tenantId, name])
  @@map("vessels")
}

// ─── Vessel–client relationships and fleets (M7) ────────────────────────────
// Design pack §14: one vessel master, linked to clients through relationships; fleets belong to
// a client and a vessel joins a fleet through its relationship with that client.

enum RelationshipStatus {
  ACTIVE
  ENDED
}

enum FleetStatus {
  ACTIVE
  INACTIVE
}

model VesselClientRelationship {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  vesselId             String             @map("vessel_id") @db.Uuid
  clientId             String             @map("client_id") @db.Uuid
  relationshipTypeId   String             @map("relationship_type_id") @db.Uuid
  relationshipTypeList String             @default("vessel-relationship-type") @map("relationship_type_list")
  /// At most one active primary relationship per vessel (partial unique index).
  isPrimary            Boolean            @default(false) @map("is_primary")
  status               RelationshipStatus @default(ACTIVE)
  startDate            DateTime?          @map("start_date") @db.Date
  endDate              DateTime?          @map("end_date") @db.Date
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vessel           Vessel        @relation(fields: [vesselId, tenantId], references: [id, tenantId], onDelete: Restrict)
  client           Client        @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  relationshipType ReferenceItem @relation("RelationshipType", fields: [relationshipTypeId, relationshipTypeList], references: [id, listKey], onDelete: Restrict)
  fleetMemberships FleetVessel[]

  @@unique([id, tenantId])
  /// Target for fleet_vessels, pinning a membership to this relationship's vessel and client.
  @@unique([id, vesselId, clientId])
  @@index([vesselId])
  @@index([clientId])
  @@map("vessel_client_relationships")
}

model Fleet {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  clientId  String      @map("client_id") @db.Uuid
  /// Generated per tenant: FL-00001.
  code      String
  /// Unique per client, ignoring case (expression index).
  name      String
  status    FleetStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client  Client        @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  members FleetVessel[]

  @@unique([tenantId, code])
  /// Target for fleet_vessels, pinning a membership to this fleet's client.
  @@unique([id, clientId])
  @@index([clientId])
  @@map("fleets")
}

/// A vessel in a fleet, through its relationship with the fleet's client. Composite FKs make the
/// fleet and the relationship belong to the same client; removed_at keeps history.
model FleetVessel {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  fleetId        String    @map("fleet_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  vesselId       String    @map("vessel_id") @db.Uuid
  relationshipId String    @map("relationship_id") @db.Uuid
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  removedAt      DateTime? @map("removed_at")

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client       Client                   @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict)
  fleet        Fleet                    @relation(fields: [fleetId, clientId], references: [id, clientId], onDelete: Restrict, onUpdate: NoAction)
  relationship VesselClientRelationship @relation(fields: [relationshipId, vesselId, clientId], references: [id, vesselId, clientId], onDelete: Restrict, onUpdate: NoAction)

  @@index([fleetId])
  @@index([relationshipId])
  @@map("fleet_vessels")
}
