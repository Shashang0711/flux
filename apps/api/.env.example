NODE_ENV=development
PORT=4000
# Matches docker-compose.yml (host port 5433). Point at your own Postgres if not using Docker.
DATABASE_URL=postgresql://flux:flux@localhost:5433/flux?schema=public
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# COOKIE_SECURE defaults to true in production, false otherwise.
# COOKIE_SECURE=true
TRUST_PROXY=loopback
LOGIN_RATE_LIMIT=10

# Bootstrap platform admin, created by `npm run db:seed` if it does not exist.
# Password must be at least 8 characters. Change it after first login.
FLUX_ADMIN_EMAIL=admin@flux.local
FLUX_ADMIN_NAME=Platform Administrator
FLUX_ADMIN_PASSWORD=
